TEST_ENV=local
BASE_URL=http://localhost:8443
API_URL=https://gpekfosbyobdffavrumi.supabase.co

# Server-side only - mints test sessions via the Supabase admin API (see
# tests/support/mint-session.ts). NEVER commit a real value here or put it
# in the app's own .env. Copy this file to tests/.env (gitignored) and fill
# in the real key from Supabase project settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated test accounts, pre-seeded via tests/support/seed-test-accounts.ts
# (`node --experimental-strip-types tests/support/seed-test-accounts.ts`).
# Do not use a real staff email (see tests/README.md).
TEST_PATRON_EMAIL=playwright-test-patron@sss-library-test.invalid
TEST_STAFF_EMAIL=playwright-test-staff@sss-library-test.invalid
