VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: enables book cover art on the book detail page (Google Books API).
# Without this set, the detail page falls back to the placeholder icon.
# Restrict the key to the Books API + your app's HTTP referrer(s) in Google
# Cloud Console — this is exposed client-side.
VITE_GOOGLE_BOOKS_API_KEY=
